<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Capital One Legacy Loan Service</display-name>

    <listener>
        <listener-class>com.capitalone.loansvc.web.AppStartupListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>LoanApplyServlet</servlet-name>
        <servlet-class>com.capitalone.loansvc.web.LoanApplyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoanApplyServlet</servlet-name>
        <url-pattern>/apply</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EligibilityServlet</servlet-name>
        <servlet-class>com.capitalone.loansvc.web.EligibilityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EligibilityServlet</servlet-name>
        <url-pattern>/eligibility</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UnderwriteServlet</servlet-name>
        <servlet-class>com.capitalone.loansvc.web.UnderwriteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UnderwriteServlet</servlet-name>
        <url-pattern>/underwrite</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CustomerServlet</servlet-name>
        <servlet-class>com.capitalone.loansvc.web.CustomerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerServlet</servlet-name>
        <url-pattern>/customer</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminReloadServlet</servlet-name>
        <servlet-class>com.capitalone.loansvc.web.AdminReloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminReloadServlet</servlet-name>
        <url-pattern>/admin/reload</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
