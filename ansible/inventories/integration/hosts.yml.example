---
# Copy/fill after EC2 exists, or run deploy/provision-integration-ec2.sh
all:
  children:
    loan_app_servers:
      hosts:
        loan-svc-integration:
          ansible_host: REPLACE_WITH_PUBLIC_IP
          ansible_user: ec2-user
          ansible_ssh_private_key_file: /path/to/loan-svc-integration.pem
